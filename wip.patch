+        from hermes_cli.config import load_config_readonly
+        from hermes_cli.runtime_provider import _FROZEN_RUNTIME_CONFIG
+        return _FROZEN_RUNTIME_CONFIG.get() or load_config_readonly()
+    except Exception:
